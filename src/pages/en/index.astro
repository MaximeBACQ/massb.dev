---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import TwoLanes from "../../components/TwoLanes.astro";
import ProjectsPreview from "../../components/ProjectsPreview.astro";
import HostedAtHome from "../../components/HostedAtHome.astro";
import { defaultLang } from "../../i18n/ui";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";

const lang = Astro.currentLocale ?? getLangFromUrl(Astro.url) ?? defaultLang;
const t = useTranslations(lang);
---

<BaseLayout title="massb.dev" description={t("site.description")}>
  <main>
    <Hero
      eyebrow={t("hero.eyebrow")}
      headline={t("hero.headline")}
      headlineHighlight={t("hero.headlineHighlight")}
      tagline={t("hero.tagline")}
      selfHostLine={t("hero.selfHostLine")}
      primaryCta={{
        label: t("hero.cta.primary"),
        href: getRelativeLocaleUrl(lang, "/projects"),
      }}
      secondaryCta={{ label: t("hero.cta.secondary"), href: "#hosted-at-home" }}
    />
    <TwoLanes />
    <ProjectsPreview />
    <HostedAtHome />
  </main>
</BaseLayout>
