---
// Infra layers (Proxmox, OPNsense, reverse proxy, Docker, TLS, 3-2-1 backups)
// and their roles are the architecture confirmed in CLAUDE.md ("Hosted at
// home" note + Infra lane). Each detail line describes that confirmed role,
// no invented figures/hardware; specific numbers can be added later.

import { defaultLang } from "../i18n/ui";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale ?? getLangFromUrl(Astro.url) ?? defaultLang;
const t = useTranslations(lang);

const items = [
  { label: t("hostedAtHome.item.proxmox"), detail: t("hostedAtHome.detail.proxmox") },
  { label: t("hostedAtHome.item.opnsense"), detail: t("hostedAtHome.detail.opnsense") },
  { label: t("hostedAtHome.item.proxy"), detail: t("hostedAtHome.detail.proxy") },
  { label: t("hostedAtHome.item.docker"), detail: t("hostedAtHome.detail.docker") },
  { label: t("hostedAtHome.item.tls"), detail: t("hostedAtHome.detail.tls") },
];
---

<section id="hosted-at-home" class="scroll-mt-20 px-6 py-20 sm:px-10">
  <div class="mx-auto max-w-6xl">
    <p class="inline-flex items-center gap-2 border border-border px-3 py-1 font-mono text-xs uppercase tracking-wide text-text-muted">
      <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
      {t("hostedAtHome.eyebrow")}
    </p>
    <h2 class="mt-4 font-display text-4xl font-bold leading-tight text-text sm:text-5xl">
      {t("hostedAtHome.heading")}
    </h2>
    <p class="mt-4 max-w-prose font-sans text-text-muted">
      {t("hostedAtHome.intro")}
    </p>

    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item) => (
          <div class="border border-border bg-surface p-5">
            <p class="font-mono text-sm text-text">{item.label}</p>
            <p class="mt-2 font-sans text-sm text-text-muted">
              {item.detail}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
