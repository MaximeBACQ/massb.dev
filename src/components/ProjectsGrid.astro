---
import { projects } from "../data/projects";
import type { ProjectStatus, ProjectTag } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
import { defaultLang } from "../i18n/ui";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale ?? getLangFromUrl(Astro.url) ?? defaultLang;
const t = useTranslations(lang);

// Only show a tag filter if a current project actually uses it, no dead pills.
const ALL_TAGS: ProjectTag[] = [
  "game",
  "tool",
  "cyber",
  "web",
  "backend",
  "low-level",
  "industrial",
];
const usedTags = ALL_TAGS.filter((tag) =>
  projects.some((project) => project.tags.includes(tag)),
);

const tagLabels: Record<ProjectTag, string> = {
  game: t("tag.game"),
  tool: t("tag.tool"),
  cyber: t("tag.cyber"),
  web: t("tag.web"),
  backend: t("tag.backend"),
  "low-level": t("tag.low-level"),
  industrial: t("tag.industrial"),
};

const ALL_STATUSES: ProjectStatus[] = ["stable", "experimental", "archived"];
const statusLabels: Record<ProjectStatus, string> = {
  stable: t("status.stable"),
  experimental: t("status.experimental"),
  archived: t("status.archived"),
};
---

<section class="px-6 py-20 sm:px-10">
  <div class="mx-auto max-w-6xl">
    <p
      class="inline-flex items-center gap-2 border border-border px-3 py-1 font-mono text-xs uppercase tracking-wide text-text-muted"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"
      ></span>
      {t("projects.eyebrow")}
    </p>
    <h2 class="mt-4 font-display text-4xl font-bold leading-tight text-text sm:text-5xl">
      {t("projects.page.heading")}
    </h2>

    <div class="mt-8 flex flex-col gap-3">
      <div class="flex flex-wrap items-center gap-2">
        <span
          class="mr-1 font-mono text-[11px] uppercase tracking-wide text-text-muted"
        >
          {t("projects.filter.type")}
        </span>
        <button
          type="button"
          class="filter-pill"
          data-filter-group="tag"
          data-filter-value=""
          data-active="true">{t("projects.filter.all")}</button
        >
        {
          usedTags.map((tag) => (
            <button
              type="button"
              class="filter-pill"
              data-filter-group="tag"
              data-filter-value={tag}
              data-active="false"
            >
              {tagLabels[tag]}
            </button>
          ))
        }
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <span
          class="mr-1 font-mono text-[11px] uppercase tracking-wide text-text-muted"
        >
          {t("projects.filter.status")}
        </span>
        <button
          type="button"
          class="filter-pill"
          data-filter-group="status"
          data-filter-value=""
          data-active="true">{t("projects.filter.all")}</button
        >
        {
          ALL_STATUSES.map((status) => (
            <button
              type="button"
              class="filter-pill"
              data-filter-group="status"
              data-filter-value={status}
              data-active="false"
            >
              {statusLabels[status]}
            </button>
          ))
        }
      </div>
    </div>

    <div
      class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
      data-project-grid
    >
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>

    <p
      class="mt-10 hidden font-mono text-sm text-text-muted"
      data-empty-state
    >
      {t("projects.empty")}
    </p>
  </div>
</section>

<style>
  .filter-pill {
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
    transition:
      color 150ms,
      border-color 150ms;
  }
  /* Hover only where it's real: on touch, a tap leaves :hover stuck, so a
     just-deselected pill would still look active. */
  @media (hover: hover) {
    .filter-pill:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
  }

  /* Touch: ~36px tall hit area (rows are 8px apart, so stay within that). */
  @media (pointer: coarse) {
    .filter-pill {
      position: relative;
    }

    .filter-pill::after {
      content: "";
      position: absolute;
      inset: -4px 0;
    }
  }
  .filter-pill[data-active="true"] {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>

<script>
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-project-card]"),
  );
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-filter-group]"),
  );
  const emptyState = document.querySelector<HTMLElement>("[data-empty-state]");

  const active: Record<"tag" | "status", Set<string>> = {
    tag: new Set(),
    status: new Set(),
  };

  function applyFilters() {
    let visibleCount = 0;
    for (const card of cards) {
      const cardTags = (card.dataset.tags ?? "").split(",").filter(Boolean);
      const cardStatus = card.dataset.status ?? "";

      const tagMatch =
        active.tag.size === 0 || cardTags.some((tag) => active.tag.has(tag));
      const statusMatch =
        active.status.size === 0 || active.status.has(cardStatus);

      const visible = tagMatch && statusMatch;
      card.classList.toggle("hidden", !visible);
      if (visible) visibleCount += 1;
    }
    emptyState?.classList.toggle("hidden", visibleCount !== 0);
  }

  for (const button of buttons) {
    button.addEventListener("click", () => {
      const group = button.dataset.filterGroup as "tag" | "status";
      const value = button.dataset.filterValue ?? "";
      const groupButtons = buttons.filter(
        (b) => b.dataset.filterGroup === group,
      );

      if (value === "") {
        active[group].clear();
      } else if (active[group].has(value)) {
        active[group].delete(value);
      } else {
        active[group].add(value);
      }

      for (const b of groupButtons) {
        const bValue = b.dataset.filterValue ?? "";
        const isActive =
          bValue === "" ? active[group].size === 0 : active[group].has(bValue);
        b.dataset.active = String(isActive);
      }

      applyFilters();
    });
  }
</script>
