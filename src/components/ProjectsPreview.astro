---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
import { defaultLang } from "../i18n/ui";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { getRelativeLocaleUrl } from "astro:i18n";

const featured = projects.filter((project) => project.featured);

const lang = Astro.currentLocale ?? getLangFromUrl(Astro.url) ?? defaultLang;
const t = useTranslations(lang);
const projectsHref = getRelativeLocaleUrl(lang, "/projects");
---

<section id="projects" class="scroll-mt-20 px-6 py-20 sm:px-10">
  <div class="mx-auto max-w-6xl">
    <p
      class="inline-flex items-center gap-2 border border-border px-3 py-1 font-mono text-xs uppercase tracking-wide text-text-muted"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"
      ></span>
      {t("projects.eyebrow")}
    </p>
    <div class="mt-4 flex flex-wrap items-end justify-between gap-4">
      <h2 class="font-display text-4xl font-bold leading-tight text-text sm:text-5xl">
        {t("projects.preview.heading")}
      </h2>
      <a
        href={projectsHref}
        class="tap-target font-mono text-sm uppercase tracking-wide text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
      >
        {t("projects.all")}
      </a>
    </div>

    <div
      class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
    >
      {featured.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>
