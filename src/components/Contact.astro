---
import { defaultLang } from "../i18n/ui";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = Astro.currentLocale ?? getLangFromUrl(Astro.url) ?? defaultLang;
const t = useTranslations(lang);

// Handed to the client script so it can show server-side errors in the
// page's language.
const messages = {
  sending: t("contact.form.sending"),
  send: t("contact.form.send"),
  name: t("contact.error.name"),
  email: t("contact.error.email"),
  length: t("contact.error.message.length"),
  links: t("contact.error.message.links"),
  "too-fast": t("contact.error.too-fast"),
  expired: t("contact.error.expired"),
  invalid: t("contact.error.expired"),
  "rate-limited": t("contact.error.rate-limited"),
  generic: t("contact.error.generic"),
};

const MESSAGE_MAX = 5000;
---

<section class="px-6 py-16 sm:px-10 sm:py-20">
  <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[5fr_7fr] lg:gap-16">
    <div class="lg:pt-2">
      <p
        class="inline-flex items-center gap-2 border border-border px-3 py-1 font-mono text-xs uppercase tracking-wide text-text-muted"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        {t("contact.eyebrow")}
      </p>
      <h1 class="mt-4 font-display text-4xl font-bold leading-tight text-text sm:text-5xl">
        {t("contact.heading")}
      </h1>
      <p class="mt-5 max-w-sm font-sans text-lg text-text-muted">
        {t("contact.intro")}
      </p>

      <p class="mt-10 max-w-sm border-l-2 border-accent/60 pl-4 font-sans text-sm leading-relaxed text-text-muted">
        {t("contact.privacy")}
      </p>

      <a
        href="https://www.linkedin.com/in/maxime-bacq/"
        target="_blank"
        rel="noopener noreferrer"
        class="linkedin-link mt-8 inline-flex items-baseline gap-3 font-sans text-sm"
      >
        <span class="text-text">{t("contact.linkedin")}</span>
        <span class="inline-flex items-center gap-1 font-mono text-text-muted transition-colors">
          linkedin.com/in/maxime-bacq
          <svg class="linkedin-arrow" viewBox="0 0 12 12" width="9" height="9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3.5 2.5h6v6M9.5 2.5l-7 7" />
          </svg>
        </span>
      </a>
    </div>

    <div class="contact-panel relative border border-border bg-surface" data-contact>
      <form
        class="contact-form flex flex-col gap-6 p-6 sm:p-8"
        novalidate
        data-messages={JSON.stringify(messages)}
      >
        <div class="grid gap-6 sm:grid-cols-2">
          <div class="field">
            <label for="contact-name">{t("contact.form.name")}</label>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              maxlength="100"
              required
              aria-describedby="contact-name-error"
            />
            <p id="contact-name-error" class="field-error" data-error-for="name"></p>
          </div>
          <div class="field">
            <label for="contact-email">{t("contact.form.email")}</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              maxlength="254"
              required
              aria-describedby="contact-email-error"
            />
            <p id="contact-email-error" class="field-error" data-error-for="email"></p>
          </div>
        </div>

        <div class="field">
          <div class="flex items-baseline justify-between gap-4">
            <label for="contact-message">{t("contact.form.message")}</label>
            <span class="font-mono text-xs tabular-nums text-text-muted" data-counter aria-hidden="true">
              0 / {MESSAGE_MAX}
            </span>
          </div>
          <textarea
            id="contact-message"
            name="message"
            rows="6"
            maxlength={MESSAGE_MAX}
            required
            placeholder={t("contact.form.messagePlaceholder")}
            aria-describedby="contact-message-error"></textarea>
          <p id="contact-message-error" class="field-error" data-error-for="message"></p>
        </div>

        {/* Honeypot: invisible to people, tempting to bots. */}
        <div class="honeypot" aria-hidden="true">
          <label for="contact-website">{t("contact.form.honeypot")}</label>
          <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
          <button type="submit" class="send-button">
            <span data-send-label>{t("contact.form.send")}</span>
            <svg class="send-icon" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2.5 8h10m-4-4 4 4-4 4" />
            </svg>
          </button>
          <span class="hidden font-mono text-xs text-text-muted sm:inline" aria-hidden="true" data-shortcut>
            Ctrl + Enter
          </span>
        </div>

        <p class="form-status" role="alert" data-status></p>
      </form>

      <div class="contact-sent" hidden tabindex="-1" data-sent>
        <svg class="sent-mark" viewBox="0 0 48 48" width="48" height="48" fill="none" aria-hidden="true">
          <circle cx="24" cy="24" r="22" stroke="currentColor" stroke-width="1.5" />
          <path d="M15 24.5l6 6 12-13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <h2 class="mt-6 font-display text-3xl font-bold leading-tight text-text">
          {t("contact.form.sent.heading")}
        </h2>
        <p class="mt-3 font-sans text-text-muted">
          {t("contact.form.sent.body")}{" "}<span class="text-text" data-sent-email></span>.
        </p>
        <button type="button" class="mt-8 font-sans text-sm font-semibold text-accent underline decoration-accent/40 underline-offset-4 transition-colors hover:decoration-accent" data-again>
          {t("contact.form.sent.again")}
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-panel {
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
  }

  .linkedin-link:hover .font-mono {
    color: var(--color-accent);
  }

  .linkedin-arrow {
    transition: transform 250ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .linkedin-link:hover .linkedin-arrow {
    transform: translate(1.5px, -1.5px);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field label {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.5;
    transition:
      border-color 200ms var(--ease),
      box-shadow 250ms var(--ease),
      background-color 200ms var(--ease);
  }

  .field textarea {
    min-height: 9.5rem;
    resize: none;
    field-sizing: content;
    max-height: 28rem;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: color-mix(in srgb, var(--color-text-muted) 70%, transparent);
  }

  .field input:hover,
  .field textarea:hover {
    border-color: color-mix(in srgb, var(--color-text-muted) 45%, var(--color-border));
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-bg) 70%, var(--color-surface));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 22%, transparent);
  }

  .field [aria-invalid="true"] {
    border-color: var(--color-accent);
  }

  .field-error {
    min-height: 0;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: #d9764f;
  }

  .field-error:empty {
    display: none;
  }

  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .send-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    overflow: hidden;
    border: 1px solid var(--color-accent);
    background: var(--color-accent);
    padding: 0.75rem 1.4rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-bg);
    cursor: pointer;
    transition:
      background-color 200ms var(--ease),
      color 200ms var(--ease);
  }

  .send-button:hover {
    background: transparent;
    color: var(--color-accent);
  }

  .send-icon {
    transition: transform 300ms var(--ease);
  }

  .send-button:hover .send-icon {
    transform: translateX(3px);
  }

  /* Sending: a thin bar sweeps along the button's bottom edge. */
  .send-button[aria-busy="true"] {
    cursor: progress;
    background: transparent;
    color: var(--color-accent);
  }

  .send-button[aria-busy="true"]::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 40%;
    background: var(--color-accent);
    animation: sweep 900ms var(--ease) infinite;
  }

  .send-button[aria-busy="true"] .send-icon {
    transform: translateX(3px);
  }

  @keyframes sweep {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(250%);
    }
  }

  .form-status {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: #d9764f;
  }

  .form-status:empty {
    display: none;
  }

  .contact-sent {
    padding: 3rem 2rem;
    color: var(--color-accent);
    outline: none;
  }

  @media (min-width: 640px) {
    .contact-sent {
      padding: 4rem 2.5rem;
    }
  }

  .contact-sent:not([hidden]) {
    animation: rise 500ms var(--ease) both;
  }

  .contact-sent:not([hidden]) .sent-mark circle {
    stroke-dasharray: 139;
    stroke-dashoffset: 139;
    animation: draw 700ms var(--ease) 100ms forwards;
  }

  .contact-sent:not([hidden]) .sent-mark path {
    stroke-dasharray: 30;
    stroke-dashoffset: 30;
    animation: draw 400ms var(--ease) 550ms forwards;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  type Messages = Record<string, string>;

  const root = document.querySelector<HTMLElement>("[data-contact]");
  const form = root?.querySelector<HTMLFormElement>("form");

  if (root && form) {
    const messages: Messages = JSON.parse(form.dataset.messages ?? "{}");
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    const buttonLabel = form.querySelector<HTMLElement>("[data-send-label]")!;
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const counter = form.querySelector<HTMLElement>("[data-counter]")!;
    const textarea = form.querySelector<HTMLTextAreaElement>("textarea")!;
    const sent = root.querySelector<HTMLElement>("[data-sent]")!;
    const sentEmail = root.querySelector<HTMLElement>("[data-sent-email]")!;
    const again = root.querySelector<HTMLButtonElement>("[data-again]")!;
    const max = textarea.maxLength;

    if (/Mac|iPhone|iPad/.test(navigator.platform)) {
      form.querySelector("[data-shortcut]")!.textContent = "⌘ + Enter";
    }

    // One-time form token from the contact service. Fetched up front so the
    // server can tell a human-paced submission from an instant bot one.
    let tokenRequest: Promise<string | null>;
    const fetchToken = () =>
      (tokenRequest = fetch("/api/contact/token", { cache: "no-store" })
        .then((res) => (res.ok ? res.json() : null))
        .then((data) => data?.token ?? null)
        .catch(() => null));
    fetchToken();

    const updateCounter = () => {
      counter.textContent = `${textarea.value.length} / ${max}`;
    };
    textarea.addEventListener("input", updateCounter);

    const setFieldError = (name: string, text: string) => {
      const field = form.elements.namedItem(name) as HTMLInputElement | null;
      const error = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (error) error.textContent = text;
      field?.setAttribute("aria-invalid", text ? "true" : "false");
    };

    const clearErrors = () => {
      for (const name of ["name", "email", "message"]) setFieldError(name, "");
      status.textContent = "";
    };

    // Clear a field's error as soon as it's being fixed.
    for (const name of ["name", "email", "message"]) {
      form.elements.namedItem(name)?.addEventListener("input", () => setFieldError(name, ""));
    }

    const validate = (data: Record<string, string>) => {
      const errors: Record<string, string> = {};
      if (!data.name || data.name.length > 100) errors.name = messages.name;
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(data.email)) errors.email = messages.email;
      if (data.message.length < 10 || data.message.length > max) errors.message = messages.length;
      else if ((data.message.match(/https?:\/\/|www\./gi) ?? []).length > 3) {
        errors.message = messages.links;
      }
      return errors;
    };

    const showErrors = (errors: Record<string, string>) => {
      for (const [name, text] of Object.entries(errors)) setFieldError(name, text);
      const first = Object.keys(errors)[0];
      (form.elements.namedItem(first) as HTMLElement | null)?.focus();
    };

    const setBusy = (busy: boolean) => {
      button.setAttribute("aria-busy", String(busy));
      button.disabled = busy;
      buttonLabel.textContent = busy ? messages.sending : messages.send;
    };

    const submit = async () => {
      if (button.disabled) return;
      clearErrors();

      const data = {
        name: (form.elements.namedItem("name") as HTMLInputElement).value.trim(),
        email: (form.elements.namedItem("email") as HTMLInputElement).value.trim(),
        message: textarea.value.trim(),
        website: (form.elements.namedItem("website") as HTMLInputElement).value,
      };

      const errors = validate(data);
      if (Object.keys(errors).length > 0) return showErrors(errors);

      setBusy(true);
      try {
        const token = (await tokenRequest) ?? (await fetchToken());
        if (!token) throw new Error("generic");

        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ ...data, token }),
        });
        const body = await res.json().catch(() => ({}));

        if (res.ok) {
          form.reset();
          updateCounter();
          sentEmail.textContent = data.email;
          form.hidden = true;
          sent.hidden = false;
          sent.focus();
          fetchToken();
          return;
        }

        if (body.error === "fields") {
          const fieldErrors: Record<string, string> = {};
          for (const [name, reason] of Object.entries(body.fields ?? {})) {
            // Server reasons: name/email → "invalid", message → "length" | "links".
            fieldErrors[name] =
              name === "message" ? (messages[reason as string] ?? messages.length) : messages[name];
          }
          showErrors(fieldErrors);
        } else {
          status.textContent = messages[body.error] ?? messages.generic;
        }
        // Every attempt uses up the token; grab a fresh one for the retry.
        fetchToken();
      } catch {
        status.textContent = messages.generic;
        fetchToken();
      } finally {
        setBusy(false);
      }
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      submit();
    });

    form.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && (event.ctrlKey || event.metaKey)) {
        event.preventDefault();
        submit();
      }
    });

    again.addEventListener("click", () => {
      sent.hidden = true;
      form.hidden = false;
      (form.elements.namedItem("name") as HTMLElement).focus();
    });
  }
</script>
