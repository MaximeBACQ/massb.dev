---
import HeroFigure from "./HeroFigure.astro";

interface Cta {
  label: string;
  href: string;
}

interface Props {
  eyebrow: string;
  headline: string;
  tagline: string;
  selfHostLine: string;
  primaryCta: Cta;
  secondaryCta: Cta;
}

const { eyebrow, headline, tagline, selfHostLine, primaryCta, secondaryCta } =
  Astro.props;
---

<section class="px-6 pb-20 pt-16 sm:px-10 sm:pt-20">
  <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[1.4fr_1fr] lg:items-center">
    <div>
      <p class="inline-flex items-center gap-2 border border-border px-3 py-1 font-mono text-xs uppercase tracking-wide text-text-muted">
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        {eyebrow}
      </p>
      <h1 class="mt-4 font-display text-3xl font-semibold leading-snug text-text sm:text-4xl">
        {headline}
      </h1>
      <p class="mt-6 max-w-prose font-sans text-lg text-text-muted">
        {tagline}
      </p>
      <p class="mt-3 flex items-center gap-2 font-mono text-sm text-text-muted">
        <span class="text-accent" aria-hidden="true">&gt;</span>
        {selfHostLine}
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href={primaryCta.href}
          class="border border-accent bg-accent px-5 py-2.5 font-sans text-sm font-semibold text-bg transition-colors hover:bg-transparent hover:text-accent"
        >
          {primaryCta.label}
        </a>
        <a
          href={secondaryCta.href}
          class="border border-border px-5 py-2.5 font-sans text-sm font-semibold text-text transition-colors hover:border-accent hover:text-accent"
        >
          {secondaryCta.label}
        </a>
      </div>
    </div>
    <HeroFigure />
  </div>
</section>
