---
import type { Project } from "../data/projects";
import StatusPill from "./StatusPill.astro";
import { defaultLang } from "../i18n/ui";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, year, status, kind, tags, description, links, cover } =
  project;

const lang = Astro.currentLocale ?? getLangFromUrl(Astro.url) ?? defaultLang;
const t = useTranslations(lang);

const tagLabels: Record<string, string> = {
  game: t("tag.game"),
  tool: t("tag.tool"),
  cyber: t("tag.cyber"),
  web: t("tag.web"),
  backend: t("tag.backend"),
  "low-level": t("tag.low-level"),
  industrial: t("tag.industrial"),
};
---

<article
  class="flex flex-col border border-border bg-surface"
  data-project-card
  data-status={status}
  data-tags={tags.join(",")}
>
  {
    cover ? (
      <img
        src={cover}
        alt=""
        class="aspect-video w-full border-b border-border object-cover"
      />
    ) : (
      <div class="flex aspect-video w-full items-center justify-center border-b border-dashed border-border">
        <span class="font-mono text-[11px] uppercase tracking-wide text-text-muted">
          {t("projects.noCover")}
        </span>
      </div>
    )
  }

  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-display text-xl font-bold leading-tight text-text">
        {title[lang]}
      </h3>
      <span class="shrink-0 font-mono text-xs text-text-muted">
        {year ?? t("projects.yearTbd")}
      </span>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <StatusPill status={status} />
      {
        kind === "writeup-only" && (
          <span class="font-mono text-[11px] uppercase tracking-wide text-text-muted">
            {t("projects.writeupOnly")}
          </span>
        )
      }
    </div>

    <p class="flex-1 font-sans text-sm text-text-muted">{description[lang]}</p>

    {
      tags.length > 0 && (
        <ul class="flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <li class="border border-border px-2 py-0.5 font-mono text-[11px] uppercase tracking-wide text-text-muted">
              {tagLabels[tag]}
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-1 flex flex-wrap items-center gap-4 border-t border-border pt-3">
      {
        links.length > 0 ? (
          links.map((link) => (
            <a
              href={link.url}
              class="font-mono text-xs uppercase tracking-wide text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
            >
              {link.label}
            </a>
          ))
        ) : (
          <span class="font-mono text-xs uppercase tracking-wide text-text-muted">
            {t("projects.linksTbd")}
          </span>
        )
      }
    </div>
  </div>
</article>
