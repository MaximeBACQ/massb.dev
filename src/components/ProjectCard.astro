---
import type { Project } from "../data/projects";
import StatusPill from "./StatusPill.astro";
import { defaultLang } from "../i18n/ui";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, year, status, kind, tags, description, links, cover } =
  project;

const lang = Astro.currentLocale ?? getLangFromUrl(Astro.url) ?? defaultLang;
const t = useTranslations(lang);

// Cover hover actions: first link on the left half, second on the right.
const coverActions = links.slice(0, 2);
const isExternal = (url: string) => /^https?:\/\//.test(url);
const iconFor = (label: string) => {
  const l = label.toLowerCase();
  if (l.includes("play")) return "play";
  if (l.includes("download")) return "download";
  if (l.includes("source") || l.includes("code")) return "code";
  return "open";
};
// "Play" links are desktop WebGL builds that don't run on phones: touch
// screens get a "PC only" note instead, and the cover opens the next link.
const isPlay = (label: string) => iconFor(label) === "play";
const touchCoverLink = links.find((link) => !isPlay(link.label));

const tagLabels: Record<string, string> = {
  game: t("tag.game"),
  tool: t("tag.tool"),
  cyber: t("tag.cyber"),
  web: t("tag.web"),
  backend: t("tag.backend"),
  "low-level": t("tag.low-level"),
  industrial: t("tag.industrial"),
};
---

<article
  class="project-card flex flex-col border border-border bg-surface"
  data-project-card
  data-status={status}
  data-tags={tags.join(",")}
>
  <div class="cover relative overflow-hidden border-b border-border" data-actions={coverActions.length}>
    {
      cover ? (
        <img src={cover} alt="" class="cover-img aspect-video w-full object-cover" />
      ) : (
        <div class="cover-img flex aspect-video w-full items-center justify-center border-b border-dashed border-border">
          <span class="font-mono text-[11px] uppercase tracking-wide text-text-muted">
            {t("projects.noCover")}
          </span>
        </div>
      )
    }

    {
      /* Mouse/touch shortcut only — the same links are in the card footer for
         keyboard and screen-reader users, so these stay out of the tab order. */
      coverActions.length > 0 && (
        <div class="cover-actions" aria-hidden="true">
          {coverActions.map((link, i) => (
            <a
              href={link.url}
              tabindex="-1"
              class={`cover-half ${i === 0 ? "is-left" : "is-right"}`}
              {...(isExternal(link.url) ? { target: "_blank", rel: "noopener" } : {})}
            >
              <span class="cover-pill">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  {iconFor(link.label) === "play" && <path d="M5 3.5v9l7-4.5z" fill="currentColor" />}
                  {iconFor(link.label) === "download" && <path d="M8 2.5v8m-3.5-3.5L8 10.5l3.5-3.5M3 13.5h10" />}
                  {iconFor(link.label) === "code" && <path d="M5.5 4.5 2 8l3.5 3.5m5-7L14 8l-3.5 3.5" />}
                  {iconFor(link.label) === "open" && <path d="M6 3h7v7M13 3 4 12" />}
                </svg>
                {link.label}
              </span>
            </a>
          ))}
          {coverActions.length === 2 && <span class="cover-divider" />}
        </div>
      )
    }

    {
      /* Touch screens: no hover overlay, so tapping the cover just opens the
         primary link (also in the footer, hence hidden from keyboard/AT). */
      touchCoverLink && (
        <a
          href={touchCoverLink.url}
          class="cover-tap"
          tabindex="-1"
          aria-hidden="true"
          {...(isExternal(touchCoverLink.url) ? { target: "_blank", rel: "noopener" } : {})}
        />
      )
    }
  </div>

  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-display text-xl font-bold leading-tight text-text">
        {title[lang]}
      </h3>
      <span class="shrink-0 font-mono text-xs text-text-muted">
        {year ?? t("projects.yearTbd")}
      </span>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <StatusPill status={status} />
      {
        kind === "writeup-only" && (
          <span class="font-mono text-[11px] uppercase tracking-wide text-text-muted">
            {t("projects.writeupOnly")}
          </span>
        )
      }
    </div>

    <p class="flex-1 font-sans text-sm text-text-muted">{description[lang]}</p>

    {
      tags.length > 0 && (
        <ul class="flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <li class="border border-border px-2 py-0.5 font-mono text-[11px] uppercase tracking-wide text-text-muted">
              {tagLabels[tag]}
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-1 flex flex-wrap items-center gap-4 border-t border-border pt-3">
      {
        links.length > 0 ? (
          links.map((link) => (
            <>
              <a
                href={link.url}
                class:list={[
                  "tap-target font-mono text-xs uppercase tracking-wide text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent",
                  { "desktop-only": isPlay(link.label) },
                ]}
              >
                {link.label}
              </a>
              {isPlay(link.label) && (
                <span class="touch-only font-mono text-xs uppercase tracking-wide text-text-muted">
                  {t("projects.pcOnly")}
                </span>
              )}
            </>
          ))
        ) : (
          <span class="font-mono text-xs uppercase tracking-wide text-text-muted">
            {t("projects.linksTbd")}
          </span>
        )
      }
    </div>
  </div>
</article>

<style>
  /* Card hover: a barely-there lift — grows ~1.5%, border warms toward rust. */
  .project-card {
    transition:
      transform 400ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 300ms ease,
      background-color 300ms ease;
  }

  /* Keyboard focus lifts the card everywhere; mouse hover only where hover is
     real (on touch it would stick after a tap). */
  .project-card:has(:focus-visible) {
    transform: scale(1.015);
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    background-color: color-mix(in srgb, var(--color-surface) 95%, var(--color-text));
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card:hover {
      transform: scale(1.015);
      border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
      background-color: color-mix(in srgb, var(--color-surface) 95%, var(--color-text));
    }
  }

  /* Cover hover: image fades back under a warm "infra blob" brown wash, and the
     cover splits into two soft halves (primary action left, secondary right). */
  .cover {
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
  }

  .cover-img {
    transition:
      opacity 450ms var(--ease),
      transform 600ms var(--ease),
      filter 450ms var(--ease);
  }

  .cover-actions {
    position: absolute;
    inset: 0;
    display: flex;
    opacity: 0;
    transition: opacity 350ms var(--ease);
  }

  .cover-half {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Each half is its own soft, rectangular vignette: brown glowing in from
       all four edges, see-through near-black in the middle where the pill sits.
       An inset shadow follows the box shape (a radial gradient reads as a circle). */
    background: color-mix(in srgb, var(--color-bg) 45%, transparent);
    box-shadow: inset 0 0 48px 6px color-mix(in srgb, var(--color-bark) 80%, transparent);
    transition:
      flex-grow 450ms var(--ease),
      box-shadow 400ms var(--ease);
  }

  .cover-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: #211b15;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    box-shadow: 0 6px 18px -8px rgb(0 0 0 / 0.6);
    opacity: 0;
    transition:
      opacity 400ms var(--ease),
      transform 500ms var(--ease),
      background-color 250ms var(--ease);
  }

  .is-left .cover-pill {
    transform: translateX(-14px);
  }

  .is-right .cover-pill {
    transform: translateX(14px);
  }

  .cover-divider {
    position: absolute;
    top: 22%;
    bottom: 22%;
    left: 50%;
    width: 1px;
    background: color-mix(in srgb, var(--color-text) 35%, transparent);
    transform: scaleY(0);
    transition:
      transform 500ms var(--ease),
      left 450ms var(--ease);
  }

  /* Revealed state: mouse/trackpad users only. Touch screens have no real
     hover (a tap fakes one and would reveal + navigate at once), so they get
     the plain cover and use the footer links instead. */
  @media (hover: hover) and (pointer: fine) {
    .cover:hover .cover-img {
      opacity: 0.3;
      transform: scale(1.05);
      filter: blur(2px) saturate(0.7);
    }

    .cover:hover .cover-actions {
      opacity: 1;
    }

    .cover:hover .cover-pill {
      opacity: 1;
      transform: none;
      transition-delay: 60ms;
    }

    .cover:hover .cover-divider {
      transform: scaleY(1);
    }

    /* The hovered half widens slightly and its edges glow a bit deeper;
       the divider follows it. */
    .cover-half:hover {
      flex-grow: 1.25;
      box-shadow: inset 0 0 64px 12px color-mix(in srgb, var(--color-bark) 90%, transparent);
    }

    .cover-half:hover .cover-pill {
      background: var(--color-accent);
      transform: translateY(-2px);
    }

    .cover-actions:has(.is-left:hover) .cover-divider {
      left: 55.5%;
    }

    .cover-actions:has(.is-right:hover) .cover-divider {
      left: 44.5%;
    }
  }

  .cover-tap,
  .touch-only {
    display: none;
  }

  @media not ((hover: hover) and (pointer: fine)) {
    .cover-actions,
    .desktop-only {
      display: none;
    }

    .touch-only {
      display: inline;
    }

    .cover-tap {
      display: block;
      position: absolute;
      inset: 0;
    }
  }
</style>
