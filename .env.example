# Contact relay settings (copy to .env, never commit .env).

# SMTP account the relay sends through.
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (usually port 465); false = STARTTLS, which is enforced.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address; defaults to SMTP_USER.
MAIL_FROM=

# Optional. Where messages are delivered (defaults to the address in server.mjs).
CONTACT_TO=
# Optional. Max messages per day across all senders (default 50).
DAILY_CAP=
# Optional. HMAC key for form tokens; random per process when unset.
TOKEN_SECRET=

# Optional docker-compose overrides for the web container's published port.
# WEB_BIND defaults to 127.0.0.1; set it to this host's private IP if the
# reverse proxy runs on another machine.
WEB_BIND=
WEB_PORT=
